<?xml version="1.0"?>
<!--
  GERADO por ca_gazebo/scripts/gerar_mundo.py - nao editar a mao (correr o script outra vez).
  Armazem com a pista FNR (Conducao Autonoma) a escala real (lado menor 7.0 m, escala x1.0793).
  Frame do mundo = frame "map" do ROS. O launch acrescenta os obstaculos no marcador abaixo.
-->
<sdf version="1.8">
  <world name="pista">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.2 0.22 0.25 1</background>
      <grid>false</grid>
    </scene>
    <light type="directional" name="sol">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.5 0.5 0.5 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>-0.3 0.2 -0.9</direction>
    </light>
<light type="point" name="lamp_0"><pose>0.0 0.0 2.9 0 0 0</pose><diffuse>0.55 0.55 0.5 1</diffuse><specular>0.1 0.1 0.1 1</specular><attenuation><range>14</range><constant>0.4</constant><linear>0.02</linear><quadratic>0.004</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
<light type="point" name="lamp_1"><pose>4.0 0.0 2.9 0 0 0</pose><diffuse>0.55 0.55 0.5 1</diffuse><specular>0.1 0.1 0.1 1</specular><attenuation><range>14</range><constant>0.4</constant><linear>0.02</linear><quadratic>0.004</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
<light type="point" name="lamp_2"><pose>8.0 0.0 2.9 0 0 0</pose><diffuse>0.55 0.55 0.5 1</diffuse><specular>0.1 0.1 0.1 1</specular><attenuation><range>14</range><constant>0.4</constant><linear>0.02</linear><quadratic>0.004</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
<light type="point" name="lamp_3"><pose>0.0 6.0 2.9 0 0 0</pose><diffuse>0.55 0.55 0.5 1</diffuse><specular>0.1 0.1 0.1 1</specular><attenuation><range>14</range><constant>0.4</constant><linear>0.02</linear><quadratic>0.004</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
<light type="point" name="lamp_4"><pose>4.0 6.0 2.9 0 0 0</pose><diffuse>0.55 0.55 0.5 1</diffuse><specular>0.1 0.1 0.1 1</specular><attenuation><range>14</range><constant>0.4</constant><linear>0.02</linear><quadratic>0.004</quadratic></attenuation><cast_shadows>false</cast_shadows></light>
<light type="point" name="lamp_5"><pose>8.0 6.0 2.9 0 0 0</pose><diffuse>0.55 0.55 0.5 1</diffuse><specular>0.1 0.1 0.1 1</specular><attenuation><range>14</range><constant>0.4</constant><linear>0.02</linear><quadratic>0.004</quadratic></attenuation><cast_shadows>false</cast_shadows></light>

    <model name="chao">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.46 0.46 0.44 1</ambient><diffuse>0.46 0.46 0.44 1</diffuse></material>
        </visual>
      </link>
    </model>
    <!-- pista: 3112 x 2144 px, 10.160 x 7.000 m, canto inferior esquerdo em (-1.2952, -0.8095) -->
    <model name="mapa">
      <static>true</static>
      <pose>3.7850 2.6905 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10.1604 7.0000</size></plane></geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal><albedo_map>media/pista.png</albedo_map></metal></pbr>
          </material>
        </visual>
      </link>
    </model>
