<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gui_pista</name>
  <version>0.1.0</version>
  <description>GUI (Tkinter) para desenhar a pista, planear a trajetoria (Hybrid A*, DWA, MPC, linha de corrida) e publicar /reference_path, /occupancy_grid e /obstacles_marker.</description>
  <maintainer email="duarte.antonio.eu@gmail.com">Duarte Diamantino</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-yaml</exec_depend> <!-- [ca_ws] load_map_yaml -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
