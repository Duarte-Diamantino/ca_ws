<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ca_gui</name>
  <version>0.1.0</version>
  <description>GUI da simulacao: mapa da pista a escala real, caminhos pela estrada, obstaculos (Gazebo + /obstacles), conduzir (MPC, DWA, teclado) e afinar o MPC</description>
  <maintainer email="duarte.antonio.eu@gmail.com">Duarte Diamantino</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ca_sim</exec_depend>
  <exec_depend>ca_gazebo</exec_depend>
  <exec_depend>mpc_python</exec_depend>
  <exec_depend>pickup_description</exec_depend>
  <exec_depend>python3-pyqt5</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
