Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Reference Frame: map
    # so quando ha map_server (gazebo_sim.launch.py). /map_rviz = /map republicado de 2 em 2 s pelo
    # ca_sim/map_relay: o Reset do RViz apaga o mapa e nao volta a subscrever o /map
    - Class: rviz_default_plugins/Map
      Name: Mapa da pista
      Enabled: true
      Alpha: 0.6
      Topic:
        Value: /map_rviz
        Durability Policy: Transient Local
    # limites/objetivos desenhados no GUI_pista (so com path:=gui)
    - Class: rviz_default_plugins/MarkerArray
      Name: GUI_pista
      Enabled: true
      Topic:
        Value: /gui_pista/markers
    - Class: rviz_default_plugins/Path
      Name: Reference path
      Enabled: true
      Color: 25; 255; 0
      Line Style: Lines
      Topic:
        Value: /reference_path
    - Class: rviz_default_plugins/Odometry
      Name: Simulated odometry
      Enabled: true
      Keep: 300
      Position Tolerance: 0.05
      Angle Tolerance: 0.1
      Shape:
        Value: Arrow
        Color: 255; 25; 0
        Shaft Length: 0.3
        Head Length: 0.1
      Topic:
        Value: /odometry/filtered
    - Class: rviz_default_plugins/MarkerArray
      Name: Predicted trajectories
      Enabled: true
      Topic:
        Value: /predicted_trajectories
    - Class: rviz_default_plugins/MarkerArray
      Name: Obstacles
      Enabled: true
      Topic:
        Value: /obstacles_marker
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
    # so com sim:=gazebo (o robot_state_publisher do ca_gazebo publica /robot_description)
    - Class: rviz_default_plugins/RobotModel
      Name: Carro (Gazebo)
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Durability Policy: Transient Local
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 75
      X: 3.8
      Y: 2.7
Window Geometry:
  Height: 800
  Width: 1200
