<?xml version="1.0"?>
<robot name="carro_com_rodas_mov">
  <!-- Base link -->
  <link name="base_link">
    <visual>
      <geometry>
        <mesh filename="package://carro_com_rodas_mov_urdf/meshes/base_link.stl"/>
      </geometry>
    </visual>
  </link>

  <!-- Rodas -->
  <link name="front_left_wheel">
    <visual>
      <geometry>
        <mesh filename="package://carro_com_rodas_mov_urdf/meshes/roda_urfd_v3.stl"/>
      </geometry>
    </visual>
  </link>

  <link name="front_right_wheel">
    <visual>
      <geometry>
        <mesh filename="package://carro_com_rodas_mov_urdf/meshes/roda_urfd_v3.stl"/>
      </geometry>
    </visual>
  </link>

  <link name="rear_left_wheel">
    <visual>
      <geometry>
        <mesh filename="package://carro_com_rodas_mov_urdf/meshes/roda_urfd_v3.stl"/>
      </geometry>
    </visual>
  </link>

  <link name="rear_right_wheel">
    <visual>
      <geometry>
        <mesh filename="package://carro_com_rodas_mov_urdf/meshes/roda_urfd_v3.stl"/>
      </geometry>
    </visual>
  </link>

  <!-- Joints para as rodas -->
  <joint name="front_left_wheel_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="100" velocity="10"/>
    <origin xyz="0.5 0.5 0.2" rpy="0 0 0"/>
  </joint>

  <joint name="front_right_wheel_joint" type="revolute">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="100" velocity="10"/>
    <origin xyz="0.5 -0.5 0.2" rpy="0 0 0"/>
  </joint>

  <joint name="rear_left_wheel_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="100" velocity="10"/>
    <origin xyz="-0.5 0.5 0.2" rpy="0 0 0"/>
  </joint>

  <joint name="rear_right_wheel_joint" type="revolute">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="100" velocity="10"/>
    <origin xyz="-0.5 -0.5 0.2" rpy="0 0 0"/>
  </joint>
</robot>

